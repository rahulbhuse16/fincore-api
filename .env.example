# Copy to .env  (or run scripts/init-env.sh, which generates strong random values for you).
# NEVER commit .env. Every value below is a placeholder; services refuse to start with a placeholder JWT secret.

# >= 32 bytes, random.  Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# Password of the first ADMIN user ("admin"). Must satisfy the password policy (12+ chars, upper, lower, digit, symbol).
BOOTSTRAP_ADMIN_PASSWORD=change-me-Admin-1!

POSTGRES_PASSWORD=change-me
IDENTITY_DB_PASSWORD=change-me
CUSTOMER_DB_PASSWORD=change-me
ACCOUNT_DB_PASSWORD=change-me
TRANSACTION_DB_PASSWORD=change-me
LEDGER_DB_PASSWORD=change-me
RISK_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
RECONCILIATION_DB_PASSWORD=change-me

REDIS_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Comma separated list of allowed browser origins. Empty = no cross-origin access.
CORS_ALLOWED_ORIGINS=

# Enables the "[simulate-notification-failure]" test hook used by scripts/demo-dlt.sh. Keep false outside demos.
NOTIFICATION_FAILURE_SIMULATION=false
